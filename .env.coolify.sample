# Copy these entries into the ignored .env; never commit real values.
COOLIFY_BASE_URL=https://coolify.fastsme.com
COOLIFY_API_TOKEN=

# Database backend: postgresql (default) | sqlite
DB_TYPE=postgresql
DB_SCHEMA=fast_skills
# DATABASE_URL falls back to DATABASE_URL_PROD if unset. postgres:// is accepted.
DATABASE_URL=
DATABASE_URL_PROD=
# For DB_TYPE=sqlite instead:
# FASTSKILLS_DB=data/fastskills.sqlite

# App
FASTSKILLS_SECRET=
FASTSKILLS_PUBLIC_URL=https://fastskills.org

# Google SSO (leave blank to disable the Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated email-domain allow-list (blank = any Google account)
GOOGLE_ALLOWED_DOMAINS=

# Local-account email (optional; Postmark). Blank = email flows disabled.
POSTMARK_API_TOKEN=
FROM_EMAIL=
FASTSME_PUBLIC_URL=https://fastskills.org
